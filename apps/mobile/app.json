{
  "expo": {
    "name": "Café Travesía",
    "slug": "cafe-travesia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cafetravesia",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F3EA",
    "primaryColor": "#111A31",
    "description": "Café especial de Caicedo, Antioquia: tienda, suscripción, Academia y asistente.",
    "ios": {
      "bundleIdentifier": "co.cafetravesia.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:cafetravesia.co"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.cafetravesia.app",
      "adaptiveIcon": {
        "backgroundColor": "#111A31",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cafetravesia.co",
              "pathPrefix": "/tienda"
            },
            {
              "scheme": "https",
              "host": "cafetravesia.co",
              "pathPrefix": "/academia"
            },
            {
              "scheme": "https",
              "host": "cafetravesia.co",
              "pathPrefix": "/cuenta"
            },
            {
              "scheme": "https",
              "host": "cafetravesia.co",
              "pathPrefix": "/suscripciones"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Café Travesía",
      "themeColor": "#111A31",
      "backgroundColor": "#F8F3EA"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111A31",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#EB9A37",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "grupovepormas",
    "extra": {
      "eas": {
        "projectId": "11e514a1-d4ef-4525-88bb-5e0dd3256002"
      },
      "router": {}
    }
  }
}
