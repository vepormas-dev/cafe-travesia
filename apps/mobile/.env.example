# ─── API ───────────────────────────────────────────────────────────────
# Backend Next.js (misma API que la web). Si no responde, la app entra en MODO DEMO.
EXPO_PUBLIC_API_URL=https://cafetravesia.com
# 1 = forzar modo demo (capturas, desarrollo sin backend)
EXPO_PUBLIC_DEMO=0

# ─── Firebase Auth (Consola Firebase → Configuración del proyecto → App web) ───
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=cafe-travesia.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=cafe-travesia
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=cafe-travesia.appspot.com

# ─── Google Sign-In (Google Cloud Console → Credenciales → ID de cliente OAuth) ───
# iOS: tipo "iOS", bundle co.cafetravesia.app (app.config.ts agrega su esquema invertido)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android: tipo "Android", paquete co.cafetravesia.app + SHA-1 del keystore de EAS (eas credentials)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Web: el "Web client" que creó Firebase (necesario para la vista web y como audiencia del id_token)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ─── EAS (opcional si ya está en app.json → extra.eas.projectId) ───
EAS_PROJECT_ID=
