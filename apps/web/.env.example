# =============================================================================
# Café Travesía · apps/web · variables de entorno
# -----------------------------------------------------------------------------
# Local:      cp apps/web/.env.example apps/web/.env.local   (nunca subas .env.local)
# Vercel:     Settings › Environment Variables (Production / Preview).
#             Tabla completa: docs/deploy/variables.md · Guía: docs/deploy/05-vercel.md
# Validar:    node scripts/check-env.mjs -f apps/web/.env.local --target development
# Secretos:   scripts/gen-secrets.sh  (DB_GATEWAY_SECRET, CRON_SECRET, REVALIDATE_SECRET)
#
# TODO es opcional para compilar. Con este archivo tal cual (valores vacíos) el sitio
# corre en MODO DEMO: catálogo de ejemplo (seed-data), sin login, pagos ni escrituras.
# Los valores de los comentarios son FICTICIOS: reemplázalos por los reales.
# Las NEXT_PUBLIC_* se incrustan en el JavaScript del navegador al compilar: nunca
# pongas secretos en ellas y vuelve a desplegar si las cambias.
# =============================================================================

# --- Sitio -------------------------------------------------------------------
# URL canónica, sin "/" final. Producción: https://cafetravesia.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp en formato internacional, solo dígitos. Ej.: 573001234567
NEXT_PUBLIC_WHATSAPP=

# --- Base de datos MySQL/MariaDB del cPanel ----------------------------------
# gateway = pasarela PHP firmada (recomendado en Vercel Hobby/Pro sin IP fija)
# mysql   = conexión directa mysql2 (solo con Remote Database Access; ideal con Vercel Pro + Static IPs)
# Si falta alguna variable del driver elegido, el sitio cae SILENCIOSAMENTE en modo demo.
DB_DRIVER=
# URL base de la pasarela, sin /db.php y SIN "/" final. Ej.: https://gateway.cafetravesia.co
DB_GATEWAY_URL=
# Mismo valor que 'secret' en config.php de la pasarela (≥ 64 caracteres, hex).
DB_GATEWAY_SECRET=
# Tiempo máximo por llamada a la pasarela, en ms (defecto 12000).
DB_GATEWAY_TIMEOUT_MS=
# Solo con DB_DRIVER=mysql. Ej.: mysql://usuario_ctapp:CLAVE@servidor.hosting.com:3306/usuario_cafetravesia
DATABASE_URL=
# Solo mysql: conexiones por instancia (defecto 3).
DB_POOL_SIZE=
# Solo mysql: "false" = sin TLS · "strict" = TLS verificando certificado · vacío = TLS sin verificar.
DB_SSL=

# --- Medios (disco del cPanel) -----------------------------------------------
# URL pública de la carpeta de medios. Su host se autoriza en next/image AL COMPILAR.
# Ej.: https://media.cafetravesia.co   (defecto si está vacía)
NEXT_PUBLIC_MEDIA_URL=
# Solo si media.php vive en otra URL; por defecto se usa DB_GATEWAY_URL. Sin "/" final.
MEDIA_GATEWAY_URL=

# --- Firebase Auth -----------------------------------------------------------
# Firebase › Configuración del proyecto › General › Tus apps › App web (valores públicos)
# Ej.: AIzaSyA-EJEMPLO / cafe-travesia.firebaseapp.com / cafe-travesia / 1:123456789012:web:abc123
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin SDK (servidor). Opción A (recomendada): el JSON de la cuenta de servicio en base64:
#   base64 -w0 cuenta-servicio.json      (macOS: base64 -i cuenta-servicio.json)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Opción B: tres variables sueltas (deja vacía la de arriba). La clave con "\n" literales.
# Ej.: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Correos que reciben rol admin al iniciar sesión (primer administrador). Separados por coma.
# Ej.: gabo@cafetravesia.co,admin@cafetravesia.co
ADMIN_EMAILS=

# --- Pagos Wompi -------------------------------------------------------------
# comercios.wompi.co › Desarrolladores. Las 4 llaves deben ser del MISMO ambiente:
#   sandbox    → pub_test_ / prv_test_ / test_integrity_ / test_events_
#   production → pub_prod_ / prv_prod_ / prod_integrity_ / prod_events_
WOMPI_ENV=sandbox
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
# Sin este secreto el webhook /api/webhooks/wompi rechaza todos los eventos (401).
WOMPI_EVENTS_SECRET=

# --- Correo SMTP (buzón del cPanel) ------------------------------------------
# cPanel › Email Accounts › Connect Devices › Mail Client Manual Settings
# Ej.: mail.cafetravesia.co · 465 (SSL/TLS) · pedidos@cafetravesia.co
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Remitente: el mismo buzón de SMTP_USER. Ej.: Café Travesía <pedidos@cafetravesia.co>
# (si se deja vacía: Café Travesía <hola@cafetravesia.co>)
MAIL_FROM=
# Ej.: hola@cafetravesia.co
MAIL_REPLY_TO=
# Buzón interno de avisos (pedidos, leads, asesor humano). Ej.: pedidos@cafetravesia.co
ADMIN_NOTIFY_EMAIL=

# --- IA (OpenAI o API compatible) --------------------------------------------
# Sin clave el chatbot, la búsqueda y el tutor responden por reglas.
OPENAI_API_KEY=
# Defecto: https://api.openai.com/v1
OPENAI_BASE_URL=
# Defecto: gpt-4.1-mini
OPENAI_MODEL=

# --- Operación ---------------------------------------------------------------
# Protege /api/cron (Vercel Cron lo envía como "Authorization: Bearer <valor>"). ≥ 16 caracteres.
CRON_SECRET=
# Reservada: env.ts la lee pero ninguna ruta la usa todavía.
REVALIDATE_SECRET=
# Solo si activas "Enhanced push security" en expo.dev (entonces es obligatoria).
EXPO_ACCESS_TOKEN=
# Enlaces universales de la app (/.well-known/*)
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINTS=

# --- Solo local/CI (NO definir en Vercel) -------------------------------------
# NEXT_DIST_DIR=.next-ci      carpeta de build alternativa
# SKIP_TYPECHECK=1            omite tipos en next build (nunca en CI/Vercel)
# TEST_MYSQL_VERSION=8.4.x    versión de MySQL de npm run test -w @travesia/db
