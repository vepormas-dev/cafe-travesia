# Pasarela Café Travesía — subdominio gateway.<dominio>
Options -Indexes
ServerSignature Off

# Forzar HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Solo se exponen db.php, media.php y health.php
<FilesMatch "^(config\.php|config\.sample\.php|lib\.php|README\.md)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|log|md|json|lock|ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

# PHP: tamaño de subida (si el hosting lo permite desde .htaccess; si no, usar "MultiPHP INI Editor")
<IfModule mod_php.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 18M
  php_value max_execution_time 60
</IfModule>
